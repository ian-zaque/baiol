PORT=3000
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
APP_SCHEME=baiol
API_PUBLIC_URL=http://localhost:3000
# Expo web origin. Shared links open /join/:token here.
WEB_APP_URL=http://localhost:8081
# Long random string. The API refuses to start when this is missing.
AUTH_JWT_SECRET=replace-with-a-long-random-string
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=2592000
# Optional. When RESEND_API_KEY is set, MAIL_FROM is required.
# RESEND_API_KEY=
# MAIL_FROM=Baiol <invites@example.com>
