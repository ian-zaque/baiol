PORT=3000
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Disable "Confirm email" in Supabase Auth for local testing if you want instant login after register.
APP_SCHEME=baiol
API_PUBLIC_URL=http://localhost:3000
# Expo web origin. Shared links open /join/:token here instead of the baiol:// app scheme.
WEB_APP_URL=http://localhost:8081
